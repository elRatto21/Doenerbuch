# Postgres
DATABASE_URL=postgres://doener:doener@localhost:5432/doenerbuch

# Better Auth – generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Header with the real client IP (for login rate limiting). Coolify/Traefik: x-forwarded-for.
# Behind Cloudflare's proxy: cf-connecting-ip
TRUSTED_IP_HEADER=x-forwarded-for

# Google sign-in (optional – button is hidden when unset)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# S3 / MinIO for photos
S3_ENDPOINT=http://localhost:9000
# Optional: S3 API endpoint for the browser, only if it differs from S3_ENDPOINT (e.g. Docker-internal hostname)
S3_PUBLIC_ENDPOINT=
# Optional: public read URL of the bucket (e.g. https://pub-xxxx.r2.dev or a custom domain).
# Unset = the bucket stays private and photos are shown via signed URLs.
S3_PUBLIC_URL=
S3_REGION=us-east-1
S3_BUCKET=doenerbuch
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

# Map (MapLibre style URL, default OpenFreeMap)
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty

# Reverse geocoding (Nominatim). Set a contact address per the usage policy.
GEOCODER_URL=https://nominatim.openstreetmap.org
GEOCODER_USER_AGENT=Doenerbuch/1.0 (kontakt@example.com)

# Time zone used for month grouping and statistics
APP_TIMEZONE=Europe/Berlin

# Migrations run on server start in production; set to false to opt out
RUN_MIGRATIONS=
